<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_base">

    <View
        android:id="@+id/wallpaper"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <View
        android:layout_width="560dp"
        android:layout_height="560dp"
        android:layout_gravity="top|end"
        android:alpha="0.5"
        android:background="@drawable/bg_glow" />

    <androidx.core.widget.NestedScrollView
        android:id="@+id/scroll"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clipChildren="false"
        android:clipToPadding="false"
        android:fillViewport="true"
        android:focusable="false"
        android:overScrollMode="never"
        android:scrollbars="none">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:clipChildren="false"
            android:clipToPadding="false"
            android:focusable="false"
            android:orientation="vertical"
            android:paddingStart="56dp"
            android:paddingTop="26dp"
            android:paddingEnd="56dp"
            android:paddingBottom="36dp">

            <!-- Greeting + clock -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:baselineAligned="false"
                android:gravity="bottom"
                android:orientation="horizontal">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/greeting"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="sans-serif-light"
                        android:text="@string/greet_evening"
                        android:textColor="@color/text_primary"
                        android:textSize="30sp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:letterSpacing="0.18"
                        android:text="@string/app_name"
                        android:textAllCaps="true"
                        android:textColor="@color/text_secondary"
                        android:textSize="11sp" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:gravity="end"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/clock"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="sans-serif-light"
                        android:text="@string/clock_placeholder"
                        android:textColor="@color/text_primary"
                        android:textSize="34sp" />

                    <TextView
                        android:id="@+id/date"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="end"
                        android:text="@string/date_placeholder"
                        android:textColor="@color/text_secondary"
                        android:textSize="13sp" />
                </LinearLayout>
            </LinearLayout>

            <!-- Quick settings -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp"
                android:clipChildren="false"
                android:clipToPadding="false"
                android:orientation="horizontal">

                <include
                    android:id="@+id/tileWifi"
                    layout="@layout/tile" />

                <include
                    android:id="@+id/tileDisplay"
                    layout="@layout/tile" />

                <include
                    android:id="@+id/tileSound"
                    layout="@layout/tile" />

                <include
                    android:id="@+id/tileSettings"
                    layout="@layout/tile" />

                <include
                    android:id="@+id/tileWallpaper"
                    layout="@layout/tile" />
            </LinearLayout>

            <!-- Favorites -->
            <TextView
                style="@style/SectionTitle"
                android:text="@string/section_favorites" />

            <TextView
                android:id="@+id/favoritesEmpty"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:layout_marginBottom="6dp"
                android:text="@string/favorites_hint"
                android:textColor="@color/text_secondary"
                android:textSize="14sp"
                android:visibility="gone" />

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rvFavorites"
                style="@style/Row" />

            <!-- Recent apps -->
            <LinearLayout
                android:id="@+id/sectionRecent"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:clipChildren="false"
                android:clipToPadding="false"
                android:orientation="vertical"
                android:visibility="gone">

                <TextView
                    style="@style/SectionTitle"
                    android:text="@string/section_recent" />

                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/rvRecent"
                    style="@style/Row" />
            </LinearLayout>

            <!-- All apps -->
            <TextView
                style="@style/SectionTitle"
                android:text="@string/section_all" />

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rvAll"
                style="@style/Row" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:alpha="0.7"
                android:text="@string/hint_menu"
                android:textColor="@color/text_secondary"
                android:textSize="12sp" />
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>
</FrameLayout>
